<Window x:Class="Bibliotheque.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Authentification requise" 
        Height="280" 
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Icône et titre -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
            <TextBlock Text="🔐" FontSize="32" Margin="0,0,10,0"/>
            <TextBlock Text="Protection par mot de passe" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Message -->
        <TextBlock Grid.Row="1" 
                   Text="Veuillez entrer le mot de passe pour accéder à ce fichier de bibliothèque."
                   TextWrapping="Wrap"
                   Margin="0,0,0,15"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"/>

        <!-- Tentatives restantes -->
        <Label Grid.Row="2" 
               Name="LblAttempts" 
               Content="Tentatives restantes : 3"
               FontWeight="SemiBold"
               HorizontalAlignment="Center"
               Margin="0,0,0,10"/>

        <!-- Champ mot de passe -->
        <StackPanel Grid.Row="3" Margin="0,0,0,15">
            <Label Content="Mot de passe :" FontWeight="SemiBold"/>
            <PasswordBox Name="PwdPassword" 
                         Height="35" 
                         Padding="8"
                         FontSize="14"
                         Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Avertissement -->
        <Border Grid.Row="4" 
                Name="LblWarning"
                Background="#FFFFF3CD"
                BorderBrush="#FFFFC107"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,15"
                Visibility="Collapsed"
                CornerRadius="3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠️" FontSize="16" Margin="0,0,8,0"/>
                <TextBlock Text="ATTENTION : Le fichier sera supprimé après la dernière tentative échouée !"
                           TextWrapping="Wrap"
                           Foreground="#FF856404"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- Boutons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="BtnOk" 
                    Content="Valider" 
                    Width="120" 
                    Height="35"
                    IsDefault="True"
                    Click="BtnOk_Click"
                    Background="#FF4CAF50"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Margin="0,0,10,0"
                    Cursor="Hand"/>
            <Button Name="BtnCancel" 
                    Content="Annuler" 
                    Width="120" 
                    Height="35"
                    IsCancel="True"
                    Click="BtnCancel_Click"
                    Background="#FFF44336"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>