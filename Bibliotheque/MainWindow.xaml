<Window x:Class="Bibliotheque.MainWindow"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bibliotheque"
        mc:Ignorable="d"
        Title="Système de Gestion de Bibliothèque" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="#FF2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Height" Value="30"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Margin" Value="5,5,5,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="#FFCCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0" Background="#FF1565C0" Padding="15">
            <TextBlock Text="📚 Système de Gestion de Bibliothèque" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Contenu principal avec TabControl -->
        <TabControl Grid.Row="1" Margin="10" Name="MainTabControl">

            <!-- Onglet Livres -->
            <TabItem Header="📖 Livres" FontSize="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Formulaire d'ajout de livre -->
                    <GroupBox Header="Ajouter un Livre" Grid.Column="0" Margin="5" Padding="10">
                        <StackPanel>
                            <Label Content="Titre:"/>
                            <TextBox Name="TxtTitreLivre"/>

                            <Label Content="Auteur:"/>
                            <TextBox Name="TxtAuteurLivre"/>

                            <Label Content="ISBN:"/>
                            <xctk:MaskedTextBox Name="TxtIsbn" Mask="000-0-0000-0000-0" PromptChar="0" FontSize="20" Margin="5,5,5,5"/>

                            <Label Content="Date de publication:"/>
                            <DatePicker x:Name="PublicationDatePicker" DisplayDateStart="1/1/1700" DisplayDateEnd="12/31/2100" Margin="5,5,5,5"/>

                            <Label Content="Catégorie:"/>
                            <ComboBox Name="CmbCategorieLivre"/>

                            <Button Content="Ajouter le Livre" Name="BtnAjouterLivre" Margin="5,20,5,5" Click="AjoutLivre_Click"/>
                            <Button Content="Supprimer le Livre" Name="BtnSupprimerLivre" Background="#FFF44336" Click="BtnSupprimerLivre_Click"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Liste des livres -->
                    <GroupBox Header="Liste des Livres" Grid.Column="1" Margin="5" Padding="10">
                        <DataGrid Name="DgLivres" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Titre" Binding="{Binding Titre}" Width="1*"/>
                                <DataGridTextColumn Header="Auteur" Binding="{Binding Auteur}" Width="1*"/>
                                <DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="0.9*"/>
                                <DataGridTextColumn Header="Publication" Binding="{Binding DateDePublication}" Width="0.5*"/>
                                <DataGridTextColumn Header="Catégorie" Binding="{Binding CategorieNom}" Width="0.5*"/>
                                <DataGridTextColumn Header="Date d'ajout" Binding="{Binding DateAjout}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Onglet Utilisateurs -->
            <TabItem Header="👤 Utilisateurs" FontSize="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Formulaire d'ajout d'utilisateur -->
                    <GroupBox Header="Ajouter un Utilisateur" Grid.Column="0" Margin="5" Padding="10">
                        <StackPanel>
                            <Label Content="Nom:"/>
                            <TextBox Name="TxtNomUtilisateur"/>

                            <Label Content="Prénom:"/>
                            <TextBox Name="TxtPrenomUtilisateur"/>

                            <Label Content="Email:"/>
                            <TextBox Name="TxtEmailUtilisateur"/>

                            <Button Content="Ajouter l'Utilisateur" Name="BtnAjouterUtilisateur" Margin="5,20,5,5" Click="AjoutUtilisateur_Click"/>
                            <Button Content="Supprimer l'Utilisateur" Name="BtnSupprimerUtilisateur" Background="#FFF44336" Click="BtnSupprimerUtilisateur_Click"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Liste des utilisateurs -->
                    <GroupBox Header="Liste des Utilisateurs" Grid.Column="1" Margin="5" Padding="10">
                        <DataGrid Name="DgUtilisateurs" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="1*"/>
                                <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="*"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>
                                <DataGridTextColumn Header="Date d'inscription" Binding="{Binding DateInscription}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Onglet Catégories -->
            <TabItem Header="📂 Catégories" FontSize="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Formulaire d'ajout de catégorie -->
                    <GroupBox Header="Ajouter une Catégorie" Grid.Column="0" Margin="5,5,5,5" Padding="10">
                        <StackPanel>
                            <Label Content="Nom de la catégorie:"/>
                            <TextBox Name="TxtNomCategorie"/>

                            <Button Content="Ajouter la Catégorie" Name="BtnAjouterCategorie" Margin="5,20,5,5" Click="AjoutCategorie_Click"/>
                            <Button Content="Supprimer la Catégorie" Name="BtnSupprimerCategorie" Background="#FFF44336" Click="BtnSupprimerCategorie_Click"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Liste des catégories -->
                    <GroupBox Header="Liste des Catégories" Grid.Column="1" Margin="5,5,5,5" Padding="10">
                        <DataGrid Name="DgCategories" 
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Onglet Emprunts -->
            <TabItem Header="📋 Emprunts" FontSize="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Formulaire d'emprunt/retour -->
                    <GroupBox Header="Gestion des Emprunts" Grid.Row="0" Margin="5" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Label Content="Sélectionner un utilisateur:"/>
                                <ComboBox Name="CmbUtilisateurEmprunt" Height="30" Margin="5"/>

                                <Label Content="Date d'emprunt:"/>
                                <DatePicker Name="DpDateEmprunt" Margin="5" Height="30"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <Label Content="Sélectionner un livre:"/>
                                <ComboBox Name="CmbLivreEmprunt" Height="30" Margin="5"/>

                                <Label Content="Date de retour prévue:"/>
                                <DatePicker Name="DpDateRetourPrevue" Margin="5" Height="30"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                                <Button Content="📤 Emprunter" Name="BtnEmprunter" Width="150" Background="#FF4CAF50" Click="BtnEmprunter_Click"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Liste des emprunts -->
                    <GroupBox Header="Liste des Emprunts" Grid.Row="1" Margin="5" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Row="0">
                                <Label Content="Filtrer par statut:"/>
                                <ComboBox Name="CmbFiltreStatutEmprunt" Width="150" Height="30" Margin="5">
                                    <ComboBoxItem Content="Tous" IsSelected="True"/>
                                    <ComboBoxItem Content="En cours"/>
                                    <ComboBoxItem Content="Retournés"/>
                                    <ComboBoxItem Content="En retard"/>
                                </ComboBox>
                                <Button Content="🔍 Filtrer" Name="BtnFiltrerEmprunts" Click="BtnFiltrerEmprunts_Click"/>
                            </StackPanel>

                            <DataGrid Name="DgEmprunts" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="0.5*"/>
                                    <DataGridTextColumn Header="Livre" Binding="{Binding LivreTitre}" Width="2*"/>
                                    <DataGridTextColumn Header="Emprunteur" Binding="{Binding UtilisateurNom}" Width="1.5*"/>
                                    <DataGridTextColumn Header="Date emprunt" Binding="{Binding DateEmprunt, StringFormat='{}{0:dd/MM/yyyy}'}" Width="*"/>
                                    <DataGridTextColumn Header="Retour prévu" Binding="{Binding DateRetourPrevue, StringFormat='{}{0:dd/MM/yyyy}'}" Width="*"/>
                                    <DataGridTextColumn Header="Retour effectif" Binding="{Binding DateRetourEffective, StringFormat='{}{0:dd/MM/yyyy}'}" Width="*"/>
                                    <DataGridTextColumn Header="Statut" Binding="{Binding Statut}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Label Content="Emprunts en cours:" FontWeight="Bold"/>
                                <Label Name="LblEmpruntsEnCours" Content="0" FontWeight="Bold" Foreground="#FFFF9800"/>
                                <Label Content="  |  En retard:" FontWeight="Bold"/>
                                <Label Name="LblEmpruntsEnRetard" Content="0" FontWeight="Bold" Foreground="#FFF44336"/>
                                <Button Content="📥 Rendre le Livre" Name="BtnRendreLivre" Width="150" Background="#FFFF9800" Click="BtnRendreLivre_Click"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Onglet Données -->
            <TabItem Header="💾 Données &amp; Sécurité" FontSize="14">
                <ScrollViewer>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sérialisation/Désérialisation -->
                        <GroupBox Header="Gestion des Données" Grid.Column="0" Margin="5" Padding="5">
                            <StackPanel>
                                <Label Content="Sérialisation des données:" FontSize="16" FontWeight="Bold" Margin="1"/>
                                <Label Content="Format:"/>
                                <ComboBox Name="CmbFormatSauvegarde" Height="30" Margin="1">
                                    <ComboBoxItem Content="XML" IsSelected="True"/>
                                    <ComboBoxItem Content="JSON" IsEnabled="False"/>
                                    <ComboBoxItem Content="Binaire" IsEnabled="False"/>
                                </ComboBox>

                                <TextBlock Text="ℹ️ Note: Seul le format XML est actuellement implémenté." 
                                           TextWrapping="Wrap"
                                           Margin="5,5,5,20"
                                           Padding="5"
                                           Background="#FFE3F2FD"
                                           Foreground="#FF1976D2"
                                           FontSize="11"/>

                                <CheckBox Name="ChkActiverCryptage" 
                                          Content="Activer le cryptage des données" 
                                          Margin="5"
                                          FontWeight="SemiBold"/>

                                <Label Content="Clé de cryptage:"/>
                                <PasswordBox Name="PwdCleCryptage" Height="30" Margin="5"/>

                                <Button Content="💾 Sauvegarder toutes les données" 
                                        Name="BtnSauvegarderDonnees" 
                                        Margin="5,5,5,5"
                                        Background="#FF4CAF50"
                                        Click="BtnSauvegarder_Click"/>

                                <Separator Margin="5"/>

                                <Label Content="Désérialisation des données:" FontSize="16" FontWeight="Bold" Margin="5"/>

                                <Label Content="Fichier à charger:"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Name="TxtCheminFichierChargement" Grid.Column="0" IsReadOnly="True"/>
                                    <Button Content="📁 Parcourir" 
                                            Name="BtnParcourirFichier" 
                                            Grid.Column="1" 
                                            Width="100"
                                            Click="BtnParcourirFichier_Click"/>
                                </Grid>
                                <Label Content="Clé de décryptage:"/>
                                <PasswordBox Name="PwdCleDecryptage" Height="30" Margin="5"/>

                                <Button Content="📂 Charger les données" 
                                        Name="BtnChargerDonnees" 
                                        Margin="5,20,5,5"
                                        Background="#FF2196F3"
                                        Click="BtnCharger_Click"/>

                                <Button Content="🗑️ Réinitialiser toutes les données" 
                                        Name="BtnReinitialiserDonnees" 
                                        Margin="5,10,5,5"
                                        Background="#FFF44336"
                                        Click="BtnReinitialiserDonnees_Click"/>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Onglet Statistiques -->
            <TabItem Header="📊 Statistiques" FontSize="14">
                <ScrollViewer>
                    <StackPanel Margin="20">
                        <UniformGrid Columns="3" Rows="2" Margin="10">
                            <!-- Carte Livres -->
                            <Border Background="#FF2196F3" Margin="10" Padding="20" CornerRadius="5">
                                <StackPanel>
                                    <TextBlock Text="📚" FontSize="40" HorizontalAlignment="Center"/>
                                    <Label Name="LblStatTotalLivres" Content="0" 
                                           FontSize="36" FontWeight="Bold" 
                                           Foreground="White" HorizontalAlignment="Center"/>
                                    <Label Content="Livres au total" 
                                           FontSize="14" Foreground="White" 
                                           HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Carte Utilisateurs -->
                            <Border Background="#FF4CAF50" Margin="10" Padding="20" CornerRadius="5">
                                <StackPanel>
                                    <TextBlock Text="👥" FontSize="40" HorizontalAlignment="Center"/>
                                    <Label Name="LblStatTotalUtilisateurs" Content="0" 
                                           FontSize="36" FontWeight="Bold" 
                                           Foreground="White" HorizontalAlignment="Center"/>
                                    <Label Content="Utilisateurs" 
                                           FontSize="14" Foreground="White" 
                                           HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Carte Emprunts actifs -->
                            <Border Background="#FFFF9800" Margin="10" Padding="20" CornerRadius="5">
                                <StackPanel>
                                    <TextBlock Text="📋" FontSize="40" HorizontalAlignment="Center"/>
                                    <Label Name="LblStatEmpruntsActifs" Content="0" 
                                           FontSize="36" FontWeight="Bold" 
                                           Foreground="White" HorizontalAlignment="Center"/>
                                    <Label Content="Emprunts actifs" 
                                           FontSize="14" Foreground="White" 
                                           HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Carte Catégories -->
                            <Border Background="#FF9C27B0" Margin="10" Padding="20" CornerRadius="5">
                                <StackPanel>
                                    <TextBlock Text="📂" FontSize="40" HorizontalAlignment="Center"/>
                                    <Label Name="LblStatTotalCategories" Content="0" 
                                           FontSize="36" FontWeight="Bold" 
                                           Foreground="White" HorizontalAlignment="Center"/>
                                    <Label Content="Catégories" 
                                           FontSize="14" Foreground="White" 
                                           HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Carte Livres disponibles -->
                            <Border Background="#FF00BCD4" Margin="10" Padding="20" CornerRadius="5">
                                <StackPanel>
                                    <TextBlock Text="✅" FontSize="40" HorizontalAlignment="Center"/>
                                    <Label Name="LblStatLivresDisponibles" Content="0" 
                                           FontSize="36" FontWeight="Bold" 
                                           Foreground="White" HorizontalAlignment="Center"/>
                                    <Label Content="Livres disponibles" 
                                           FontSize="14" Foreground="White" 
                                           HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Carte Retards -->
                            <Border Background="#FFF44336" Margin="10" Padding="20" CornerRadius="5">
                                <StackPanel>
                                    <TextBlock Text="⚠️" FontSize="40" HorizontalAlignment="Center"/>
                                    <Label Name="LblStatRetards" Content="0" 
                                           FontSize="36" FontWeight="Bold" 
                                           Foreground="White" HorizontalAlignment="Center"/>
                                    <Label Content="Emprunts en retard" 
                                           FontSize="14" Foreground="White" 
                                           HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Barre d'état -->
        <StatusBar Grid.Row="2" Background="#FFE0E0E0">
            <StatusBarItem>
                <TextBlock Name="TxtStatusBar" Text="Prêt" Margin="5"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Version 1.0" Margin="5"/>
                    <Separator/>
                    <TextBlock Name="TxtDateTime" Text="" Margin="5"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
